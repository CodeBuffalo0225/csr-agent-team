    {"id": "S2-01", "invariant": "NO_SELF_GRADING", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "x", "total": 88}}, "expect": {"ok": false, "code": "SELF_GRADED"}, "note": "the model may not assert its own total"},
    {"id": "S2-02", "invariant": "NO_SELF_GRADING", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "x", "tier": "T1"}}, "expect": {"ok": false, "code": "SELF_GRADED"}, "note": "or its own tier"},
    {"id": "S2-03", "invariant": "NO_SELF_GRADING", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "x", "age_days": 10}}, "expect": {"ok": false, "code": "SELF_GRADED"}, "note": "glow-sdr hole #2: a model-supplied age moved a score 80 -> 86"},
    {"id": "S2-04", "invariant": "NO_SELF_GRADING", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "x", "total": 88, "zz_undeclared": "y"}}, "expect": {"ok": false, "code": "SELF_GRADED"}, "note": "self-grading is reported ahead of a mere unknown key"},
