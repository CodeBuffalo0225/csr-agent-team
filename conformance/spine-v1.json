    {"id": "S5-01", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Only 13% of teams report strong visibility.", "allowed": ["13%"]}, "expect": {"ok": true, "ungrounded": []}},
    {"id": "S5-02", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Only 13% have visibility, and 84% of CISOs agree.", "allowed": ["13%"]}, "expect": {"ok": false, "ungrounded": ["84%"]}, "note": "glow-sdr hole #1: an allowed stat must not launder its neighbour"},
    {"id": "S5-03", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "A bank rolled this out across 40,000 endpoints.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["40,000"]}, "note": "glow-sdr hole #3: a bare count is a claim"},
    {"id": "S5-04", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "They passed $150 million in ARR.", "allowed": ["$150M"]}, "expect": {"ok": true, "ungrounded": []}, "note": "scale words normalise"},
    {"id": "S5-05", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "83 percent already use AI.", "allowed": ["83%"]}, "expect": {"ok": true, "ungrounded": []}, "note": "percent normalises to %"},
    {"id": "S5-06", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Worth 15 minutes on September 30 before the 2027 budget?", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "durations, dates and years are not claims"},
    {"id": "S5-07", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Two-thirds of teams caught AI over-accessing data.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["Two-thirds"]}, "note": "fraction words are figures"},
    {"id": "S5-08", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "It cut alert noise 3x.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["3x"]}, "note": "multipliers are figures even when small"},
    {"id": "S5-09", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "We have 3 ideas for your team.", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "a bare number under 10 is counting, not a claim"},
    {"id": "S5-10", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Revenue doubled and 12 teams signed.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["doubled", "12"]}, "note": "order of appearance, as written"},
    {"id": "S5-11", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Before quarter end, or in the second half?", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "calendar fractions are not claims"},
    {"id": "S5-12", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Half of CISOs say so.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["Half"]}, "note": "a fraction followed by 'of' is a claim"},
    {"id": "S5-13", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Nine in ten CISOs lack visibility.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["Nine in ten"]}, "note": "ratios in words are figures (v1.1.0)"},
    {"id": "S5-14", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "3 out of 4 teams agree.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["3 out of 4"]}, "note": "ratios are figures"},
    {"id": "S5-15", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "4/5 CISOs agree.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["4/5"]}, "note": "a slash ratio before a word is a figure"},
    {"id": "S5-16", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "It is 5 times faster.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["5 times"]}, "note": "'N times' is a multiplier"},
    {"id": "S5-17", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Cut noise x5.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["x5"]}, "note": "a prefix multiplier is a multiplier"},
    {"id": "S5-18", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Cyera protects 2000 endpoints.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["2000"]}, "note": "a count in the year range is still a count"},
    {"id": "S5-19", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Plan for it in 2027, before the 2027 budget.", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "years used as years are not claims"},
    {"id": "S5-20", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "It deploys in 30 days and saves 6 hours a week.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["30 days", "6 hours"]}, "note": "durations other than meeting minutes are performance claims"},
    {"id": "S5-21", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Worth 15 minutes on 9/23?", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "meeting minutes and dates are not claims"},
    {"id": "S5-22", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Congrats to the 8x8 team on the Microsoft 365 rollout and ISO 27001.", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "product, standard and dimension-style names are not claims"},
    {"id": "S5-23", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "We are #1 in DSPM.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["#1"]}, "note": "a rank is a claim"},
    {"id": "S5-24", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "Hundreds of enterprises agree.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["Hundreds"]}, "note": "a vague magnitude is still a claim"},
    {"id": "S5-25", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "I've written twice; it's twice as fast.", "allowed": []}, "expect": {"ok": false, "ungrounded": ["twice"]}, "note": "'twice' counts only as a comparison"},
    {"id": "S5-26", "invariant": "GROUNDING", "kind": "grounding", "input": {"text": "In your first 90 days, over the last 12 months.", "allowed": []}, "expect": {"ok": true, "ungrounded": []}, "note": "the new-leader idiom and look-back context are not claims"},
