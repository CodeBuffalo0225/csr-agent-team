    {"id": "S1-01", "invariant": "STRICT_SCHEMA", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "ok", "zz_undeclared": "extra"}}, "expect": {"ok": false, "code": "UNKNOWN_KEY"}, "note": "an undeclared key is rejected, not stripped"},
    {"id": "S1-02", "invariant": "STRICT_SCHEMA", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 3, "d2": 4}, "rationale": "clean payload"}}, "expect": {"ok": true}, "note": "the control: a clean payload passes"},
    {"id": "S1-03", "invariant": "STRICT_SCHEMA", "kind": "judgment", "input": {"payload": {"entity": "acme.com", "scores": {"d1": 6, "d2": 4}, "rationale": "too high"}}, "expect": {"ok": false, "code": "OUT_OF_RANGE"}, "note": "scores are 0-5"},
