    {"id": "S8-08", "invariant": "SCOPED_APPROVAL", "kind": "approval", "input": {"tool": "email_send", "target": "acme.com", "risk": "IRREVERSIBLE", "live": true, "approvals": ["sequence_enroll:acme.com"], "content_ok": true, "harness": false}, "expect": {"decision": "deny", "code": "NO_APPROVAL"}, "note": "an approval for one tool does not carry to another"},
    {"id": "S9-01", "invariant": "BUDGET", "kind": "budget", "input": {"limits": {"calls": 2, "writes": 5}, "calls": [{"risk": "READ", "valid": true}, {"risk": "READ", "valid": true}, {"risk": "READ", "valid": true}]}, "expect": {"results": ["OK", "OK", "BUDGET"]}},
