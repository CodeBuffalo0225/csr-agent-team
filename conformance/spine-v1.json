    {"id": "S8-01", "invariant": "SCOPED_APPROVAL", "kind": "approval", "input": {"tool": "sequence_enroll", "target": "acme.com", "risk": "IRREVERSIBLE", "live": true, "approvals": ["sequence_enroll:acme.com"], "content_ok": true, "harness": false}, "expect": {"decision": "allow"}},
    {"id": "S8-02", "invariant": "SCOPED_APPROVAL", "kind": "approval", "input": {"tool": "sequence_enroll", "target": "globex.com", "risk": "IRREVERSIBLE", "live": true, "approvals": ["sequence_enroll:acme.com"], "content_ok": true, "harness": false}, "expect": {"decision": "deny", "code": "NO_APPROVAL"}, "note": "an approval for one target does not replay onto another"},
    {"id": "S8-03", "invariant": "SCOPED_APPROVAL", "kind": "approval", "input": {"tool": "sequence_enroll", "target": "acme.com", "risk": "IRREVERSIBLE", "live": true, "approvals": ["sequence_enroll:acme.com"], "content_ok": false, "harness": false}, "expect": {"decision": "deny", "code": "CONTENT_BLOCKED"}, "note": "an approval never overrides a guardrail ERROR"},
